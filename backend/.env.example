PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anime_guesser?schema=public"
REDIS_URL="redis://localhost:6379"
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
JWT_ACCESS_SECRET="change-me-in-production-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-in-production-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Anime Guesser <no-reply@animeguesser.local>"
OTP_HASH_SECRET="change-me-in-production-otp-hash-secret"

# On-the-Fly AI Clue Generation
# Primary LLM: Groq (openai/gpt-oss-120b)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Fallback LLM: Google Gemini (gemini-3.8-flash)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"
